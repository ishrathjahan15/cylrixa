# GEMINI_API_KEY: Required for Gemini AI safety explanations and multilingual analysis.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Optional External Threat Intelligence API Keys (for live remote reputation checks)
# If left blank, Clyrixa operates in offline deterministic heuristic mode with truth-in-reporting manual links.
GOOGLE_SAFE_BROWSING_API_KEY=""
VIRUSTOTAL_API_KEY=""
URLSCAN_API_KEY=""
