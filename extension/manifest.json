{
  "manifest_version": 3,
  "name": "Clyrixa — Real-Time Link Protection",
  "version": "1.0.0",
  "description": "Click Before You Trust. Analyzes links before navigation, explains phishing risks, and blocks malicious destinations.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clyrixa Link Shield"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["warning.html", "warning.css", "warning.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
